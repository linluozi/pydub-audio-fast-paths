+# High byte for each possible low-order byte of a 24 bit sample: 0x00 for
+# values whose top byte is below 0x80 (non-negative), 0xFF for negative ones.
+_24BIT_SIGN_PAD = bytes(bytearray(0 if i < 0x80 else 0xFF for i in range(256)))
+
+
+def _expand_24bit(data):
+    """
+    Widen packed 24 bit little-endian samples to 32 bit by sign extension.
+
+    Equivalent to walking ``zip(*[iter(data)]*3)`` in Python and emitting
+    ``pad(b2) + b0 + b1 + b2`` for each triple, but the four output planes are
+    filled with slice assignment instead of one Python-level iteration per
+    sample (a 7 MB file has 2.6 M samples).
+    """
+    frames = len(data) // 3
+    if not frames:
+        return b''
+    out = bytearray(frames * 4)
+    low = data[0:frames * 3:3]
+    mid = data[1:frames * 3:3]
+    high = data[2:frames * 3:3]
+    out[0::4] = high.translate(_24BIT_SIGN_PAD)
+    out[1::4] = low
+    out[2::4] = mid
+    out[3::4] = high
+    return bytes(out)
+
